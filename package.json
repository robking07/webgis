{
  "name": "webgis",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "data/registry",
    "data/ingest"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run check:design && npm run build -w web",
    "check:design": "npm run check -w @webgis/design",
    "registry:validate": "npm run validate -w @webgis/ingest",
    "ingest": "npm run ingest -w @webgis/ingest --",
    "db:migrate": "bash scripts/db-push.sh",
    "test": "vitest run",
    "check:special": "node scripts/check-special-numbers.mts",
    "test:guardrails": "node scripts/test-guardrails.mjs"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "14.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "@ts-morph/common": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "eslint": {
      "minimatch": "11.0.1"
    }
  }
}
