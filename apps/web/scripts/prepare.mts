// Runs before dev/build:
//  1. src/generated/theme.css — CSS variables for both themes, from @webgis/design tokens
//  2. public/maplibre/ — MapLibre's worker + shared chunk, for setWorkerUrl() (v6 under Turbopack)
//  3. public/tiles → data/tiles symlink: local PMTiles and data files (values/, geo/, details/)
//     during development and the e2e suite (S2)
//  4. src/generated/registry.json, regenerated from data/registry/datasets/*.yaml on every
//     build, so a new registry entry can never be missing from the app
import { copyFileSync, existsSync, mkdirSync, readFileSync, symlinkSync, writeFileSync, lstatSync } from "node:fs";
import { createRequire } from "node:module";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { THEMES, themeCssVars } from "@webgis/design";
import { loadGlossary, loadRegistry } from "@webgis/registry/load";
import { loadSpecials } from "../src/lib/specials-load.mts";
import { loadContexts } from "../src/lib/context-load.mts";
import { loadSplash } from "../src/lib/splash-load.mts";

const here = dirname(fileURLToPath(import.meta.url));
const app = join(here, "..");
const decl = (vars: Record<string, string>) => Object.entries(vars).map(([k, v]) => `  ${k}: ${v};`).join("\n");
const light = decl(themeCssVars(THEMES.light));
const dark = decl(themeCssVars(THEMES.dark));
mkdirSync(join(app, "src/generated"), { recursive: true });
writeFileSync(join(app, "src/generated/theme.css"), `/* Generated by scripts/prepare.mts from packages/design tokens. Do not edit. */
:root {\n${light}\n  color-scheme: light;\n}
:root[data-theme="dark"] {\n${dark}\n  color-scheme: dark;\n}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {\n${dark}\n    color-scheme: dark;\n  }
}
`);

const require = createRequire(import.meta.url);
const dist = dirname(require.resolve("maplibre-gl/dist/maplibre-gl.css"));
mkdirSync(join(app, "public/maplibre"), { recursive: true });
for (const f of ["maplibre-gl-worker.mjs", "maplibre-gl-shared.mjs"]) copyFileSync(join(dist, f), join(app, "public/maplibre", f));

const tiles = join(app, "../../data/tiles");
const link = join(app, "public/tiles");
mkdirSync(tiles, { recursive: true });
if (!existsSync(link) && !(() => { try { return lstatSync(link).isSymbolicLink(); } catch { return false; } })()) symlinkSync(tiles, link);
const entries = loadRegistry();
writeFileSync(join(app, "src/generated/registry.json"), JSON.stringify(entries, null, 1));
writeFileSync(join(app, "src/generated/glossary.json"), JSON.stringify(loadGlossary(), null, 1));
// 5. src/generated/specials.json: the Specials, checked and with their charts and tables computed
//    from the exported county values (D-122). A bad piece stops here with a message naming the file.
//    The values live beside the tiles (S2): read from data/tiles when it has them (local dev, e2e),
//    otherwise fetched from the tiles base (R2; https://tiles.mapwich.org when unset, so a fresh
//    clone and the Vercel build work). The parser is synchronous, so a file it doesn't have yet
//    stops the pass, gets fetched, and the pass runs again (a handful of files per piece).
const insights = JSON.parse(readFileSync(join(app, "src/generated/insights.json"), "utf8")).insights;
const remote = (process.env.NEXT_PUBLIC_TILES_BASE_URL || "").startsWith("http") ? process.env.NEXT_PUBLIC_TILES_BASE_URL! : "https://tiles.mapwich.org";
const fetched = new Map<string, unknown>();
class NeedFile extends Error { path: string; constructor(path: string) { super(`needs ${path}`); this.path = path; } }
const readData = (path: string): unknown => {
  if (fetched.has(path)) return fetched.get(path);
  const local = join(tiles, path);
  if (existsSync(local)) return JSON.parse(readFileSync(local, "utf8"));
  throw new NeedFile(path);
};
let specials: ReturnType<typeof loadSpecials>;
for (;;) {
  try { specials = loadSpecials(app, entries, insights, readData); break; } catch (e) {
    if (!(e instanceof NeedFile)) throw e;
    const r = await fetch(`${remote.replace(/\/$/, "")}/${e.path}`);
    if (r.status !== 404 && r.status !== 403 && !r.ok) throw new Error(`prepare: ${remote}/${e.path} → ${r.status}`);
    fetched.set(e.path, r.ok ? await r.json() : null);
  }
}
writeFileSync(join(app, "src/generated/specials.json"), JSON.stringify(specials, null, 1));
// 6. src/generated/context.json: "Why this matters" (issue #115), checked; a number no source quote
//    backs fails the build. Unapproved drafts never reach a production build (they show in local
//    builds and Vercel previews with ?context=preview).
const { contexts, warnings } = loadContexts(app, new Set(entries.map((d) => d.id)), process.env.VERCEL_ENV !== "production");
for (const w of warnings) console.warn(`prepare: warning: ${w}`);
writeFileSync(join(app, "src/generated/context.json"), JSON.stringify(contexts, null, 1));
// 7. src/generated/splash.json: the splash questions (issue #224), checked against the registry and
//    place names. Production builds carry none until the file says approved: true (the others show
//    them with /?splash=preview). splash-counties.json: [geoid, name, lon, lat] for every county in the
//    50 states and DC, from the search index, for the "{county}" questions; kept as is when offline.
const names = JSON.parse(readFileSync(join(app, "src/generated/names.json"), "utf8"));
const splash = loadSplash(app, new Map(entries.map((d) => [d.id, d])), names, process.env.VERCEL_ENV !== "production");
writeFileSync(join(app, "src/generated/splash.json"), JSON.stringify(splash, null, 1));
try {
  const local = join(tiles, "geo/search.json");
  const rows: [string, string, string, number, number][] = existsSync(local) ? JSON.parse(readFileSync(local, "utf8"))
    : await fetch(`${remote.replace(/\/$/, "")}/geo/search.json`).then((r) => { if (!r.ok) throw new Error(`${r.status}`); return r.json(); });
  const counties = rows.filter((r) => r[1] === "County" && !r[2].startsWith("72")).map((r) => [r[2], r[0], +r[3].toFixed(2), +r[4].toFixed(2)]);
  writeFileSync(join(app, "src/generated/splash-counties.json"), JSON.stringify(counties));
} catch (e) { console.warn(`prepare: warning: splash counties not refreshed (${(e as Error).message})`); }
console.log(`prepare: splash.json (${splash.questions.length} questions${splash.approved ? "" : ", not approved"}) ready`);
console.log(`prepare: theme.css, maplibre worker, tiles link, registry.json (${entries.length} datasets), specials.json (${specials.length} pieces), context.json (${contexts.length} maps) ready`);
