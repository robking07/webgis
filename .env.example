# Names only. Copy to .env.local (git-ignored) and fill in. Never commit values.

# Site (also set in Vercel)
# Supabase project URL (public by design)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public by design)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the PMTiles host (https://tiles.mapwich.org); empty reads /tiles locally
NEXT_PUBLIC_TILES_BASE_URL=
# Sentry client DSN (public, optional)
NEXT_PUBLIC_SENTRY_DSN=
# Authorizes the Vercel cron call to /api/keepalive
CRON_SECRET=

# Ingest (Robbie's machine only)
# Supabase session-pooler connection string with the DB password
SUPABASE_DB_URL=
# Census API key
CENSUS_API_KEY=
# Anthropic key for Weird Insights captions
ANTHROPIC_API_KEY=
# Cloudflare R2 account id
R2_ACCOUNT_ID=
# R2 access key id
R2_ACCESS_KEY_ID=
# R2 secret access key
R2_SECRET_ACCESS_KEY=
# R2 bucket name for PMTiles
R2_BUCKET=
