{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -w web -- -p 3200",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/data/median_household_income",
        "http://localhost:3200/specials/work-from-home-and-exercise"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --use-gl=swiftshader --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
