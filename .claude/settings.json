{
  "permissions": {
    "deny": [
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Edit(.env.local)",
      "Edit(**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
